# Needle3 configuration. Copy to .env and edit. The app loads .env if present.
# Values here are the safe defaults; do not commit real secrets.

# Network: loopback by default. Set FLASK_HOST=0.0.0.0 only for deliberate LAN use.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
NEEDLE_OPEN_BROWSER=1

# Runtime mode: auto | native | simulation.
# auto uses native when available; it never silently falls back to simulation.
NEEDLE_MODE=auto
NEEDLE_ALLOW_SIMULATION=1

# Native engine (optional). Install with: python -m pip install -r requirements-native.txt
# NEEDLE_MODEL=/absolute/path/to/tuned.cact
NEEDLE_GENERATION=3
NEEDLE_TELEMETRY=1

# Limits
NEEDLE_MAX_TOOL_CALLS=8
NEEDLE_REQUEST_TIMEOUT=30
NEEDLE_SESSION_TIMEOUT=3600
NEEDLE_MAX_PROMPT_CHARS=4000
NEEDLE_MAX_REQUEST_BYTES=65536
NEEDLE_MAX_NEW_TOKENS=512
NEEDLE_MAX_SESSIONS=100
NEEDLE_MAX_HISTORY=40
NEEDLE_SESSION_CONTEXT_TURNS=0

# Filesystem tools are restricted to this root. Defaults to the process cwd.
# NEEDLE_FILE_ROOT=/absolute/path/to/a/safe/folder

# CORS is disabled by default. Comma-separated origins, or * only when deliberate.
# NEEDLE_CORS_ORIGINS=https://example.com

# Shell execution is intentionally unsupported. Setting this to 1 fails startup.
NEEDLE_ENABLE_SHELL=0

# Logging
NEEDLE_LOG_LEVEL=INFO
NEEDLE_DEBUG=0

# PID file used by scripts/start.py and scripts/stop.py
NEEDLE_PID_FILE=.needle3/needle3.pid
